<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft ambient glow behind the play triangle -->
    <path
        android:pathData="M54,54m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0"
        android:fillAlpha="0.22">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30"
                android:type="radial">
                <item
                    android:color="#FF2E93"
                    android:offset="0.0" />
                <item
                    android:color="#7B2CBF"
                    android:offset="0.55" />
                <item
                    android:color="#00000000"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer rounded triangular Play Ribbon: Blue -> Purple -> Pink gradient -->
    <path
        android:pathData="M34,26 C34,21.5 38.8,18.8 42.8,21.1 L79.5,42.3 C83.5,44.6 83.5,50.4 79.5,52.7 L42.8,73.9 C38.8,76.2 34,73.5 34,69 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="22"
                android:endX="82"
                android:endY="72"
                android:type="linear">
                <item
                    android:color="#00F0FF"
                    android:offset="0.0" />
                <item
                    android:color="#7B2CBF"
                    android:offset="0.5" />
                <item
                    android:color="#FF2E93"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner dark cut-out triangle for layered 3D ribbon look -->
    <path
        android:fillColor="#0D0826"
        android:pathData="M42,35.5 C42,33.2 44.5,31.8 46.5,33.0 L67.2,45.0 C69.2,46.1 69.2,48.9 67.2,50.0 L46.5,62.0 C44.5,63.2 42,61.8 42,59.5 Z" />

    <!-- Inner glowing core play triangle: Pink -> Cyan/Purple accent -->
    <path
        android:pathData="M45.5,39.5 C45.5,38.0 47.2,37.1 48.5,37.9 L62.0,45.7 C63.3,46.5 63.3,48.5 62.0,49.3 L48.5,57.1 C47.2,57.9 45.5,57.0 45.5,55.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="45"
                android:startY="38"
                android:endX="63"
                android:endY="57"
                android:type="linear">
                <item
                    android:color="#FF2E93"
                    android:offset="0.0" />
                <item
                    android:color="#A855F7"
                    android:offset="0.55" />
                <item
                    android:color="#00F0FF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
