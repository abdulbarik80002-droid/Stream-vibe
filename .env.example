# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
GEMINI_API_KEY=MY_GEMINI_API_KEY
RAZORPAY_KEY_ID=rzp_test_StreamVibeDemoKey
RAZORPAY_MODE=TEST
RAZORPAY_BACKEND_URL=YOUR_RAZORPAY_ORDER_VERIFY_BACKEND_URL
# SECURITY NOTE: Never put RAZORPAY_KEY_SECRET in the Android client .env file.
# Store RAZORPAY_KEY_SECRET exclusively in your backend server environment variables.
EMAIL_OTP_BACKEND_URL=YOUR_EMAIL_OTP_BACKEND_URL
EMAIL_OTP_API_KEY=YOUR_EMAIL_OTP_API_KEY
RAZORPAYX_PAYOUT_BACKEND_URL=YOUR_RAZORPAYX_PAYOUT_BACKEND_URL
RAZORPAYX_WEBHOOK_SECRET=YOUR_RAZORPAYX_WEBHOOK_SECRET

